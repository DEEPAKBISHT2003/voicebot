# API Keys & Models
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=interview
DATABASE_URL=postgres://postgres:1234@localhost:5432/interview
DATABASE_URL_DOCKER=postgres://postgres:1234@db:5432/interview
DB_PORT=5432

# Service Ports
INTERVIEW_PORT=8000
COPILOT_PORT=9001
BROWSER_PORT=8002
FRONTEND_PORT=3000

# Service URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
COPILOT_URL=http://localhost:9001
COPILOT_SERVICE_URL=http://localhost:9001
BROWSER_SERVICE_URL=http://localhost:8002
VITE_COPILOT_URL=http://localhost:9001
BACKEND_WS_BASE=ws://localhost:9001
COPILOT_WS_BASE=ws://localhost:9001
LOCAL_AUDIO_WS_BASE=ws://localhost:9001

# Browser Bot Settings
BOT_DISPLAY_NAME=AI Copilot Teammate
BOT_HEADLESS=true
BOT_PREJOIN_TIMEOUT_MS=45000

# CORS (Set to specific domain for production)
CORS_ALLOWED_ORIGINS=*
