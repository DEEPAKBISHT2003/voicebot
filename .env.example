# ==============================================================================
# AI API KEYS & LLM CONFIGURATION
# ==============================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional Fallback LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_COPILOT_MODEL=llama-3.1-8b-instant

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=interview
DB_PORT=5432
DATABASE_URL=postgres://postgres:1234@localhost:5432/interview
DATABASE_URL_DOCKER=postgres://postgres:1234@db:5432/interview

# ==============================================================================
# SERVICE PORTS (Unified Architecture)
# ==============================================================================
# Unified Backend API (Interview + Copilot on Port 8000)
INTERVIEW_PORT=8000
COPILOT_PORT=8000

# Browser Automation Service Port
BROWSER_PORT=8002

# Frontend Web Dashboard Port
FRONTEND_PORT=3000

# ==============================================================================
# SERVICE & WEBSOCKET URLS
# ==============================================================================
# HTTP Base URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
COPILOT_URL=http://localhost:8000
COPILOT_SERVICE_URL=http://localhost:8000
BROWSER_SERVICE_URL=http://localhost:8002

# Frontend Vite Build Variables
VITE_API_URL=http://localhost:8000
VITE_COPILOT_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# WebSocket Base URLs
BACKEND_WS_BASE=ws://localhost:8000
COPILOT_WS_BASE=ws://localhost:8000

# In-Browser Teams Audio WebSocket (Shares network namespace with backend on port 8000)
LOCAL_AUDIO_WS_BASE=ws://localhost:8000

# ==============================================================================
# TEAMS BROWSER BOT SETTINGS
# ==============================================================================
BOT_HEADLESS=true
BOT_PREJOIN_TIMEOUT_MS=45000

# ==============================================================================
# AUDIO PROCESSING & STREAMING SETTINGS
# ==============================================================================
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=4096
STT_ENDPOINTING_MS=400

# ==============================================================================
# CORS SETTINGS
# ==============================================================================
# Comma-separated list of allowed origins. Wildcard '*' is strictly forbidden in production with credentials.
# In production, specify exact production domains (e.g.: https://interview.appzlogic.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# AUTHENTICATION & RBAC CONFIGURATION
# ==============================================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production requires a high-entropy secret with at least 32 characters (rejects weak/default values)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# ==============================================================================
# RATE LIMITING & TRUSTED PROXY CONFIGURATION
# ==============================================================================
# Comma-separated IPs or subnets for reverse proxies trusted to supply X-Real-IP
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8
LOGIN_RATE_LIMIT_PER_MINUTE=60
MICROSOFT_RATE_LIMIT_PER_MINUTE=60

# ==============================================================================
# MICROSOFT ENTRA ID SSO CONFIGURATION (Single-Tenant)
# ==============================================================================
# Backend Microsoft Entra Tenant & Token Validation (Both IDs must be valid GUIDs)
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# Single-tenant authority (multi-tenant '/common', '/organizations', '/consumers' are rejected)
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
# Organizational employee domain restriction (e.g. appzlogic.com; use '*' to allow all accounts including B2B guests)
MICROSOFT_ALLOWED_DOMAINS=appzlogic.com

# Frontend Vite Build Variables for MSAL
VITE_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_MICROSOFT_REDIRECT_URL=http://localhost:3000
VITE_MICROSOFT_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
