# API Keys & LLM Models
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_COPILOT_MODEL=llama-3.1-8b-instant

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=interview

# Database Connection URLs
# Local direct connection (outside Docker):
DATABASE_URL=postgres://postgres:1234@localhost:5432/interview

# Docker internal network connection URL (inside Docker containers):
DATABASE_URL_DOCKER=postgres://postgres:1234@db:5432/interview

# Service URLs & Ports
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
COPILOT_SERVICE_URL=http://localhost:8001
BACKEND_WS_BASE=ws://localhost:8001
COPILOT_WS_BASE=ws://localhost:8001

# CORS Allowed Origins (Set to https://yourdomain.com for production)
CORS_ALLOWED_ORIGINS=*
