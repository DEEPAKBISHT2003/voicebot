# ==============================================================================
# AI API KEYS & LLM CONFIGURATION
# ==============================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional Fallback LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_COPILOT_MODEL=llama-3.1-8b-instant

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=interview
DB_PORT=5432
DATABASE_URL=postgres://postgres:1234@localhost:5432/interview
DATABASE_URL_DOCKER=postgres://postgres:1234@db:5432/interview

# ==============================================================================
# SERVICE PORTS (Unified Architecture)
# ==============================================================================
# Unified Backend API (Interview + Copilot on Port 8000)
INTERVIEW_PORT=8000
COPILOT_PORT=8000

# Browser Automation Service Port
BROWSER_PORT=8002

# Frontend Web Dashboard Port
FRONTEND_PORT=3000

# ==============================================================================
# SERVICE & WEBSOCKET URLS
# ==============================================================================
# HTTP Base URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
COPILOT_URL=http://localhost:8000
COPILOT_SERVICE_URL=http://localhost:8000
BROWSER_SERVICE_URL=http://localhost:8002

# Frontend Vite Build Variables
VITE_API_URL=http://localhost:8000
VITE_COPILOT_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# WebSocket Base URLs
BACKEND_WS_BASE=ws://localhost:8000
COPILOT_WS_BASE=ws://localhost:8000

# In-Browser Teams Audio WebSocket (Shares network namespace with backend on port 8000)
LOCAL_AUDIO_WS_BASE=ws://localhost:8000

# ==============================================================================
# TEAMS BROWSER BOT CONFIGURATION
# ==============================================================================
BOT_DISPLAY_NAME=AI Copilot Teammate
BOT_HEADLESS=true
BOT_PREJOIN_TIMEOUT_MS=45000

# ==============================================================================
# AUDIO PROCESSING & STREAMING SETTINGS
# ==============================================================================
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=4096
STT_ENDPOINTING_MS=400

# ==============================================================================
# CORS SETTINGS
# ==============================================================================
CORS_ALLOWED_ORIGINS=*
