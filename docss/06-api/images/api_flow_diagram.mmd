flowchart TD
    subgraph FE["Frontend"]
        F1[New Interview Page]
        F2[Interview Session Page]
        F3[Copilot Session Page]
    end

    subgraph IS["Interview Service /api"]
        I1[POST /interviews/parse-resume]
