# =============================================================
# Voicebot Browser Microservice — .dockerignore
# =============================================================

# ─── Git & Workspace Config ────────────────────────────────
.git/
.gitignore
.github/

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ─── Python Virtual Environments & Cache ───────────────────
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Playwright & Browser Testing Artifacts ────────────────
.playwright/
ms-playwright/
playwright-report/
blob-report/
test-results/
.cache/
teams_bot_profile/

# ─── Runtime Data, Session Storage & Media ─────────────────
interviews/
storage/
logs/
*.log
*.png
*.jpg
*.jpeg
*.wav
*.mp3
*.pcm
temp/
tmp/

# ─── IDE & OS Files ────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
