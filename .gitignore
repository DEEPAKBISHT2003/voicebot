# ─── Credentials & Environment Files ───────────────────────
.env
.env.*
!.env.example
frontend-new/.env
frontend-new/.env.*
!frontend-new/.env.example
*.pem
*.key
*.cert

# ─── Python Virtual Environments ───────────────────────────
.venv/
venv/
ENV/
env/
.python-version

# ─── Python Cache & Compiled Code ──────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# ─── Runtime Data & Session Storage ────────────────────────
interviews/
storage/
backend/storage/
**/storage/

# ─── Audio & Media Files ───────────────────────────────────
*.wav
*.mp3
*.pcm

# ─── Database Files ────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite-journal
db.sqlite3

# ─── Node.js ──────────────────────────────────────────────
node_modules/
dist/
build/
.eslintcache
yarn-error.log
pnpm-debug.log

# ─── Docker ───────────────────────────────────────────────
postgres_data/

# ─── IDE & Editor ─────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ─── OS-Specific ──────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db

# ─── Logs & Temp Files ────────────────────────────────────
*.log
logs/
temp/
tmp/

# ─── Playwright & Browser Automation ──────────────────────
.playwright/
ms-playwright/
playwright-report/
blob-report/
test-results/
.cache/
teams_bot_profile/

# ─── AI-DLC / Kiro Workspace ─────────────────────────────
.kiro/
aidlc/
AGENTS.md

# ─── Coverage Reports ────────────────────────────────────
htmlcov/
coverage.xml
.coverage
*.cover

